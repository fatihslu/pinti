{
  "name": "fiyat-takip-uygulamasi",
  "version": "1.0.0",
  "description": "Amazon tarzı fiyat takip uygulaması",
  "main": "server.js",
  "bin": "desktop.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node seedData.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/PINTI.exe",
    "test": "node scraper.test.js && node tracker.test.js && node offerParser.test.js"
  },
  "keywords": [
    "price",
    "tracking",
    "amazon",
    "keepa",
    "camelcamelcamel"
  ],
  "author": "",
  "pkg": {
    "assets": [
      "public/**/*",
      "price_tracker.db",
      "email.config.js",
      "node_modules/sqlite3/build/Release/*.node"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "1.0.0-rc.12",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "puppeteer": "^21.6.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
